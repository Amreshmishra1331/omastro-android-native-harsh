<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for API calls, Network status, Push Notifications -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Voice typing (SpeechRecognizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Photo analysis: camera + gallery/file picking -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".OmAstroApp"
        android:allowBackup="true"
        android:dataExtractionRules="@null"
        android:fullBackupContent="@null"
        android:icon="@drawable/ic_om"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_om"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmAstro"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OmAstro"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Encrypted token store auto-initialisation (runs before Application.onCreate) -->
        <provider
            android:name=".data.remote.SecureStoreInitProvider"
            android:authorities="${applicationId}.securestoreinit"
            android:exported="false"
            android:initOrder="100" />

        <!-- Razorpay checkout host: launches the real Razorpay payment sheet and
             returns the payment result to the wallet flow -->
        <activity
            android:name=".ui.screens.wallet.RazorpayPaymentActivity"
            android:exported="false"
            android:theme="@style/Theme.OmAstro" />

        <!-- Firebase Cloud Messaging Receiver Service -->
        <service
            android:name=".notifications.OmAstroFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default Notification metadata -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_om" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/sacred_gold" />

    </application>

</manifest>
